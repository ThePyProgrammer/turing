    "commands/",
    "agents/",
    "templates/",
    "config/"
  ],
  "keywords": [
    "ml",
    "machine-learning",
    "autoresearch",
    "experiment-tracking",
    "hyperparameter-tuning",
    "autonomous-training",
    "convergence-detection",
    "model-evaluation",
    "scientific-method",
    "claude-code",
    "plugin",
    "ai-agents"
  ],
  "author": {
    "name": "Prannaya Gupta"
  },
  "homepage": "https://github.com/ThePyProgrammer/turing",
